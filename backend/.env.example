# Copy to backend/.env for local (non-Docker) development.
# In Docker Compose, these are supplied by docker/docker-compose.yml instead.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL 16 — approved architecture. Format: postgres://user:pass@host:port/dbname
DATABASE_URL=postgres://kathwada:kathwada@localhost:5432/kathwada

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# S3-compatible storage (MinIO locally)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=kathwada-documents
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
